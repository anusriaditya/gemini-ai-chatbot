{
  "info": {
    "_postman_id": "a93e439d-7df6-48e0-bb12-87a32dcfc621",
    "name": "Google Gemini AI Chatbot API",
    "description": "Comprehensive Postman test collection for the Node.js Express Google Gemini AI Chatbot API.\n\nIncludes test scenarios for:\n- API Health checks\n- Single-turn prompts\n- Technical code generation\n- Multi-turn conversation history\n- System instruction / personas\n- Validation error handling (empty prompt, missing body, wrong types)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Verifies that the server is online and checks whether the Gemini API key is configured."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Service status is online', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.status).to.eql('online');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Simple Prompt - Quantum Computing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Explain quantum computing in simple terms for a high school student.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Tests sending a standard single-turn text prompt to Gemini."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains valid text from Gemini', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.response).to.be.a('string');",
              "    pm.expect(jsonData.data.response.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Coding Prompt - Express Middleware",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Write an Express.js middleware function that logs the execution time of incoming requests.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Tests code generation with formatting."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response includes code or explanation', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.response).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Multi-turn Chat - Context Awareness",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"What city did I say I was traveling to, and what should I pack?\",\n  \"conversationHistory\": [\n    {\n      \"role\": \"user\",\n      \"text\": \"Hello, I am planning a holiday to Reykjavik, Iceland in December!\"\n    },\n    {\n      \"role\": \"model\",\n      \"text\": \"Iceland in December is magical! You will experience snowy landscapes and chances to see the Northern Lights.\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Tests sending conversation history so the model answers contextually."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response reflects context memory', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.response.toLowerCase()).to.include('reykjavik');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. System Instruction / Persona",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"What is the secret to good cooking?\",\n  \"systemInstruction\": \"You are a salty 18th-century pirate captain chef. Always speak in full pirate dialect with nautical terms.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Tests configuring custom system instruction persona."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response returned successfully', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Error Test - Empty Prompt (Expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"   \"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Verifies that empty whitespace prompts trigger HTTP 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Error code is VALIDATION_ERROR', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.error.code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Error Test - Missing Prompt Field (Expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"somethingElse\": \"hello\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat",
          "host": ["{{baseUrl}}"],
          "path": ["api", "chat"]
        },
        "description": "Verifies that omitting the 'prompt' field results in HTTP 400."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Error response returned', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
