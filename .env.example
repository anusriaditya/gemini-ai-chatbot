# ========================================================
# Google Gemini Chatbot Integration Configuration
# ========================================================

# Server Port
PORT=3000

# Google AI Studio API Key
# 1. Visit https://aistudio.google.com/app/apikey
# 2. Sign in with your Google account
# 3. Click "Create API Key"
# 4. Paste your key below
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model
# Recommended: gemini-2.5-flash (fast, cost-effective, high quality)
# Fallbacks: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Request Timeout in Milliseconds (e.g. 25000 = 25 seconds)
GEMINI_TIMEOUT_MS=25000
